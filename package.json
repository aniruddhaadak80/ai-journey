{
  "name": "ai-journey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun run scripts/validate-content.ts",
    "validate:svg": "bun scripts/validate-svg.mjs",
    "validate:mermaid": "bun scripts/validate-mermaid.mjs",
    "scan:secrets": "bun scripts/scan-secrets.mjs",
    "assets": "bun scripts/gen-assets.mjs && bun scripts/gen-mockups.mjs",
    "smoke": "bun run scripts/smoke.ts",
    "verify": "bun run validate && bun run validate:svg && bun run validate:mermaid && bun run scan:secrets && bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.54.0",
    "motion": "^14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
